load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ninja-core",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ninja_core",
    deps = ["@crates//:tokio"] + select({
        "@platforms//os:windows": ["@crates//:windows-sys"],
        "//conditions:default": ["@crates//:libc"],
    }),
)

rust_test(
    name = "ninja-core_test",
    size = "small",
    crate = ":ninja-core",
    deps = ["//crates/test-dirs"],
)
