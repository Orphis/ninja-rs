load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# Directories for tests (dev-dependency of every crate's tests).
rust_library(
    name = "test-dirs",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "test_dirs",
    testonly = True,
)

rust_test(
    name = "test-dirs_test",
    size = "small",
    crate = ":test-dirs",
)
