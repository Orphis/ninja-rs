load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "cpp-deps",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "cpp_deps",
)

rust_test(
    name = "cpp-deps_test",
    size = "small",
    crate = ":cpp-deps",
    deps = ["//crates/test-dirs"],
)
