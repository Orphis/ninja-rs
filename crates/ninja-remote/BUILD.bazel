load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ninja-remote",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ninja_remote",
    deps = [
        "//crates/ninja-core",
        "//third_party/cargo-rbe/rbe-client",
        "@crates//:anyhow",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "ninja-remote_test",
    crate = ":ninja-remote",
)
