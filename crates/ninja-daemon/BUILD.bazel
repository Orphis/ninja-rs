load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ninja-daemon",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "ninja_daemon",
    deps = [
        "//crates/cpp-deps",
        "//third_party/cargo-rbe/rbe-client",
        "@crates//:hex",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@crates//:libc"],
    }),
)

rust_test(
    name = "ninja-daemon_test",
    crate = ":ninja-daemon",
)
