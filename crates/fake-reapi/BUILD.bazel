load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "fake-reapi",
    srcs = ["src/lib.rs"],
    crate_name = "fake_reapi",
    deps = [
        "@crates//:bazel-remote-apis",
        "@crates//:hex",
        "@crates//:prost",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)

rust_binary(
    name = "fake-reapi-server",
    srcs = ["src/main.rs"],
    deps = [
        ":fake-reapi",
        "@crates//:tokio",
    ],
)
