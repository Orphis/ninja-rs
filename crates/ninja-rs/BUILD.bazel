load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "ninja_rs_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "ninja_rs",
    crate_root = "src/lib.rs",
    deps = [
        "//crates/ninja-core",
        "//crates/ninja-daemon",
        "//crates/ninja-remote",
        "//third_party/cargo-rbe/rbe-bes",
        "//third_party/cargo-rbe/rbe-client",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@crates//:libc"],
    }),
)

# Embeds the Windows long path manifest (MSVC targets; see build.rs).
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
)

rust_binary(
    name = "ninja-rs",
    srcs = ["src/main.rs"],
    deps = [
        ":build_script",
        ":ninja_rs_lib",
        "//crates/ninja-core",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "ninja_rs_lib_test",
    crate = ":ninja_rs_lib",
)

# End-to-end remote execution and build event tests against the in-process
# fake REAPI and BES server.
rust_test(
    name = "remote_e2e",
    srcs = ["tests/remote_e2e.rs"],
    data = [
        ":ninja-rs",
        "//crates/fake-reapi:test_certs",
    ],
    rustc_env = {"CARGO_BIN_EXE_ninja-rs": "$(rootpath :ninja-rs)"},
    use_libtest_harness = False,
    deps = [
        ":ninja_rs_lib",
        "//crates/fake-reapi",
        "//crates/ninja-core",
        "//crates/ninja-daemon",
        "//crates/ninja-remote",
        "//third_party/cargo-rbe/rbe-bes",
        "//third_party/cargo-rbe/rbe-client",
        "@crates//:tokio",
    ],
)

# Command line tests (tools, --status, the jobserver) running the binary.
rust_test(
    name = "cli_e2e",
    srcs = ["tests/cli_e2e.rs"],
    data = [":ninja-rs"],
    rustc_env = {"CARGO_BIN_EXE_ninja-rs": "$(rootpath :ninja-rs)"},
    use_libtest_harness = False,
    deps = [":ninja_rs_lib"] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@crates//:libc"],
    }),
)
