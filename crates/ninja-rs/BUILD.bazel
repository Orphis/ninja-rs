load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_binary.bzl", "rust_binary")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# The ninja-rs version lives here (`ninja_rs::version`): the module's, with
# the commit when stamped (`--config=stamp`, `STABLE_GIT_COMMIT` from the
# workspace status command in .bazelrc). Cargo builds ask git instead
# (build.rs).
rust_library(
    name = "ninja_rs_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "ninja_rs",
    crate_root = "src/lib.rs",
    rustc_env_files = ["commit.env"],
    stamp = -1,
    version = module_version(),
    deps = [
        "//crates/ninja-core",
        "//crates/ninja-daemon",
        "//crates/ninja-os",
        "//crates/ninja-remote",
        "//third_party/cargo-rbe/rbe-bes",
        "//third_party/cargo-rbe/rbe-client",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ] + select({
        "@platforms//os:windows": ["@crates//:windows-sys"],
        "//conditions:default": ["@crates//:libc"],
    }),
)

# Embeds the Windows long path manifest (see build.rs); the commit comes
# from stamping, not from git.
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    build_script_env = {"NINJA_RS_BAZEL": "1"},
)

rust_binary(
    name = "ninja-rs",
    srcs = ["src/main.rs"],
    deps = [
        ":build_script",
        ":ninja_rs_lib",
        "//crates/ninja-core",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "ninja_rs_lib_test",
    size = "small",
    crate = ":ninja_rs_lib",
    # The versions the crates get (options::tests).
    data = [
        "//:Cargo.toml",
        "//:MODULE.bazel",
    ],
    version = module_version(),
    deps = [
        "//crates/fake-reapi",
        "//crates/test-dirs",
    ],
)

# End-to-end remote execution and build event tests against the in-process
# fake REAPI and BES server: a few minutes, split in shards (the harness
# honours TEST_SHARD_INDEX, and --test_filter) of under a minute each, a
# few on a busy machine.
rust_test(
    name = "remote_e2e",
    size = "medium",
    srcs = [
        "tests/harness/mod.rs",
        "tests/remote_e2e.rs",
    ],
    crate_root = "tests/remote_e2e.rs",
    data = [
        ":ninja-rs",
        "//crates/fake-reapi:test_certs",
    ],
    rustc_env = {"CARGO_BIN_EXE_ninja-rs": "$(rootpath :ninja-rs)"},
    shard_count = 4,
    use_libtest_harness = False,
    deps = [
        ":ninja_rs_lib",
        "//crates/fake-reapi",
        "//crates/ninja-core",
        "//crates/ninja-daemon",
        "//crates/ninja-remote",
        "//crates/test-dirs",
        "//third_party/cargo-rbe/rbe-bes",
        "//third_party/cargo-rbe/rbe-client",
        "@crates//:prost",
        "@crates//:serde_json",
        "@crates//:tokio",
    ] + select({
        "@platforms//os:windows": ["@crates//:windows-sys"],
        "//conditions:default": ["@crates//:libc"],
    }),
)

# Command line tests (tools, --status, the jobserver) running the binary.
rust_test(
    name = "cli_e2e",
    size = "medium",
    srcs = [
        "tests/cli_e2e.rs",
        "tests/harness/mod.rs",
    ],
    crate_root = "tests/cli_e2e.rs",
    data = [":ninja-rs"],
    rustc_env = {"CARGO_BIN_EXE_ninja-rs": "$(rootpath :ninja-rs)"},
    use_libtest_harness = False,
    deps = [
        ":ninja_rs_lib",
        "//crates/ninja-core",
        "//crates/ninja-remote",
        "//crates/test-dirs",
    ] + select({
        "@platforms//os:windows": ["@crates//:windows-sys"],
        "//conditions:default": ["@crates//:libc"],
    }),
)
