--- a/toolchain/args/windows/msvc/BUILD.bazel
+++ b/toolchain/args/windows/msvc/BUILD.bazel
@@ -1,8 +1,17 @@
+load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
 load("@rules_cc//cc/toolchains:args.bzl", "cc_args")
 load("@rules_cc//cc/toolchains/impl:documented_api.bzl", "cc_args_list")
 
 package(default_visibility = ["//toolchain/args/windows:__pkg__"])
 
+# The SDK case overlays are generated by //tools/case_insensitive_vfs, a
+# stage1-hosted tool built for the exec platform from runtimes built in the
+# earlier stages. When Bazel runs on Windows with an MSVC exec platform,
+# building that tool with these args would depend on the overlays it
+# generates (a cycle). Windows filesystems are case-insensitive, so runtime
+# stages there do without the overlays; user code ("complete") keeps them.
+_SKIP_RUNTIME_CASE_OVERLAYS = "@platforms//os:windows" in HOST_CONSTRAINTS
+
 # TODO: Load this from an EULA-free metadata repository once windows_support
 # exposes one. Keep it synchronized with msvc_runtime.configure in MODULE.bazel.
 _MSVC_COMPATIBILITY_VERSION = "19.50.35717"
@@ -217,20 +226,44 @@
     },
 )
 
-cc_args_list(
-    name = "normalized_sdk_compile_args",
+cc_args(
+    name = "sdk_library_search_paths_without_case_overlay",
+    actions = [
+        "@rules_cc//cc/toolchains/actions:link_actions",
+    ],
     args = [
-        "windows_sdk_compile_defines",
-        "sdk_header_case_overlay",
-        "sdk_includes",
+        "/clang:-Xlinker",
+        "/clang:/LIBPATH:{winsdk_ucrt_lib}",
+        "/clang:-Xlinker",
+        "/clang:/LIBPATH:{winsdk_um_lib}",
+    ],
+    data = [
+        "//runtimes/msvc:winsdk_ucrt_lib",
+        "//runtimes/msvc:winsdk_um_lib",
     ],
+    format = {
+        "winsdk_ucrt_lib": "//runtimes/msvc:winsdk_ucrt_lib",
+        "winsdk_um_lib": "//runtimes/msvc:winsdk_um_lib",
+    },
+)
+
+cc_args_list(
+    name = "normalized_sdk_compile_args",
+    args = ["windows_sdk_compile_defines"] + select({
+        "//toolchain:runtimes_all": ["sdk_header_case_overlay"],
+        "//conditions:default": [] if _SKIP_RUNTIME_CASE_OVERLAYS else ["sdk_header_case_overlay"],
+    }) + ["sdk_includes"],
     visibility = ["//visibility:public"],
 )
 
 cc_args_list(
     name = "normalized_default_libs",
