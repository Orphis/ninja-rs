+def _is_msvc_search_option(arg):
+    """Whether `arg` is a link.exe/lld-link option that locates libraries."""
+    upper = arg.upper()
+    for prefix in ("/LIBPATH:", "-LIBPATH:", "/VFSOVERLAY:", "-VFSOVERLAY:"):
+        if upper.startswith(prefix):
+            return True
+    return False
+
