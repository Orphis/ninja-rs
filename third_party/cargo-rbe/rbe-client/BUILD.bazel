load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "rbe-client",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "rbe_client",
    deps = [
        "//crates/ninja-os",
        "@crates//:anyhow",
        "@crates//:bazel-remote-apis",
        "@crates//:fastcdc",
        "@crates//:hex",
        "@crates//:hyper-util",
        "@crates//:prost",
        "@crates//:rustls",
        "@crates//:sha2",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:zstd",
    ],
)

rust_test(
    name = "rbe-client_test",
    # Up to 53 s of a small test's 60 under load.
    size = "medium",
    # The test certificates (TLS tests).
    compile_data = ["//crates/fake-reapi:test_certs"],
    crate = ":rbe-client",
    deps = [
        "//crates/test-dirs",
        "@crates//:h2",
    ],
)
