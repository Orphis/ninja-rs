load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

# Generates the BES service and BEP messages from proto/ with protox (no
# system protoc).
cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = glob(["proto/**"]),
    deps = [
        "@crates//:protox",
        "@crates//:tonic-prost-build",
    ],
)

rust_library(
    name = "rbe-bes",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "rbe_bes",
    deps = [
        ":build_script",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:prost-types",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
        "@crates//:tonic-prost",
    ],
)

rust_test(
    name = "rbe-bes_test",
    crate = ":rbe-bes",
)

rust_test(
    name = "uploader_test",
    srcs = ["tests/uploader.rs"],
    deps = [
        ":rbe-bes",
        "@crates//:anyhow",
        "@crates//:prost",
        "@crates//:tokio",
        "@crates//:tokio-stream",
        "@crates//:tonic",
    ],
)
