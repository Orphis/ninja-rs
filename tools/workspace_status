#!/bin/sh
# Bazel's workspace status in stamped builds (--config=stamp, see .bazelrc):
# the commit, which they put in the ninja-rs version, with .dirty after it
# when tracked files differ from it (or git can't tell). Nothing outside a
# git checkout of its own (sources copied into another repository).
[ -z "$(git rev-parse --show-cdup 2>/dev/null || echo no)" ] || exit 0
commit=$(git rev-parse --short=12 HEAD 2>/dev/null) || exit 0
changes=$(git --no-optional-locks status --porcelain --untracked-files=no 2>/dev/null) || changes=unknown
echo "STABLE_GIT_COMMIT $commit${changes:+.dirty}"
